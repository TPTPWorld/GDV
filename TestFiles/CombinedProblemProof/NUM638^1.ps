% SZS output start ListOfFormulae
%------------------------------------------------------------------------------
thf(nat_type,type,
    nat: $tType ).

thf(x,type,
    x: nat ).

thf(n_1,type,
    n_1: nat ).

thf(n,axiom,
    x != n_1 ).

thf(suc,type,
    suc: nat > nat ).

thf(some,type,
    some: ( nat > $o ) > $o ).

thf(ax4,axiom,
    ! [Xx: nat,Xy: nat] :
      ( ( ( suc @ Xx )
        = ( suc @ Xy ) )
     => ( Xx = Xy ) ) ).

thf(satz3,axiom,
    ! [Xx: nat] :
      ( ( Xx != n_1 )
     => ( some
        @ ^ [Xu: nat] :
            ( Xx
            = ( suc @ Xu ) ) ) ) ).

thf(satz3a,conjecture,
    ~ ( ! [Xx_0: nat,Xy: nat] :
          ( ( x
            = ( suc @ Xx_0 ) )
         => ( ( x
              = ( suc @ Xy ) )
           => ( Xx_0 = Xy ) ) )
     => ~ ( some
          @ ^ [Xu: nat] :
              ( x
              = ( suc @ Xu ) ) ) ) ).

%------------------------------------------------------------------------------
% SZS output end ListOfFormulae
